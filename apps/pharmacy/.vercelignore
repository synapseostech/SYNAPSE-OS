# Vercel ignore patterns for synapse-pharmacy app
#
# Vercel applies this file from the repository root, where a bare directory
# name matches at any depth. "supabase/", "scripts/" and "demo/" therefore
# removed apps/pharmacy/lib/supabase, the build gate and the /demo routes.
# Every path pattern below is anchored so it can only match what it names.

# Build cache and temporary files
.next/cache
.next/trace
.turbo
node_modules
coverage
.nyc_output
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Tests are never imported by a production build
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx

# Development files
.env*.local
.env*.development
*.tsbuildinfo

# IDE and OS files
.vscode
.idea
.DS_Store
Thumbs.db

# Documentation
*.md

# Local Supabase CLI state. The app's own clients live in lib/supabase and
# must be uploaded.
/supabase/migrations/
**/supabase/**/migrations/*.sql

# Legacy tree and CI-produced readiness artifacts
/legacy/
/artifacts/
