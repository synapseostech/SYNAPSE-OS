{
  "expo": {
    "name": "Synapse",
    "slug": "synapse-app",
    "version": "1.2.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "synapse",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "tech.synapseos.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Synapse uses the camera to scan product barcodes for inventory lookup."
      }
    },
    "android": {
      "package": "tech.synapseos.app",
      "versionCode": 6,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#07070A"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 37,
            "targetSdkVersion": 36,
            "buildToolsVersion": "37.0.0"
          }
        }
      ],
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 100,
          "resizeMode": "contain",
          "backgroundColor": "#07070A"
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Synapse to use Face ID to unlock the app."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#F97316"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Synapse to use the camera to scan product barcodes."
        }
      ],
      "expo-sqlite"
    ],
    "extra": {
      "supabaseUrl": "https://qfqakzmjatszisuqjwon.supabase.co",
      "supabaseAnonKey": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InFmcWFrem1qYXRzemlzdXFqd29uIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzU1NTQzODksImV4cCI6MjA5MTEzMDM4OX0.iFCseUE1uVvCuz_wP37agvzulXya17aGG9s49Lnz92o",
      "webAppUrl": "https://www.synapseos.tech",
      "pharmacyAppUrl": "https://pharm.synapseos.tech",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "547aa81a-9d93-447e-afc3-16f10eee6cb9"
      }
    },
    "owner": "ebrinejason"
  }
}
