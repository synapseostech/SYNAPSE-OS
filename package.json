    "test:clinical-documents": "tsx --test packages/db/src/clinical-documents.test.ts packages/db/src/referral-loop.test.ts packages/db/src/consent.test.ts && vitest run apps/web/src/app/api/clinical/documents/route.test.ts apps/web/src/app/api/patient/consent/route.test.ts apps/web/src/app/api/facility/referral/letter/route.test.ts apps/web/src/app/api/facility/referral/route.test.ts",
    "test:death-pathways": "tsx --test packages/db/src/death-pronouncement.test.ts packages/db/src/mortuary.test.ts packages/db/src/pathways.test.ts && vitest run apps/web/src/app/api/clinical/death-pronouncements/route.test.ts apps/web/src/app/api/mortuary/bodies/route.test.ts apps/web/src/app/api/mortuary/tag/[bodyNumber]/route.test.ts apps/web/src/app/api/mortuary/bodies/[id]/transition/route.test.ts apps/web/src/app/api/mortuary/bodies/[id]/release/route.test.ts apps/web/src/app/api/opd/encounters/[id]/disposition/route.test.ts apps/web/src/app/api/clinical/pathways/route.test.ts apps/web/src/app/api/clinical/intelligence/pathway/route.test.ts",
    "test:lab-golden-journey": "tsx --test packages/db/src/lab-golden-journey.test.ts packages/db/src/lab-result-persist.test.ts packages/db/src/lab-device-intelligence.test.ts",
    "test:lab-workflow-retry": "tsx --test packages/db/src/lab-workflow.retry.test.ts",
    "test:ehr-continuity-golden": "tsx --test packages/db/src/ehr-continuity-golden.test.ts",
    "test:clinical-payment": "tsx --test packages/db/src/clinical-payment.test.ts packages/db/src/identifiers.test.ts packages/db/src/lab-order-persist.test.ts",
    "test:lab-actions": "vitest run apps/web/src/app/api/lab/actions/route.test.ts apps/web/src/lib/hospital-lab-db.linkage.test.ts apps/web/src/lib/hospital-shared/audit.test.ts apps/web/src/app/api/lab/instrument-ingest/route.test.ts apps/web/src/app/api/lab/instrument-ingest/auth.route.test.ts apps/web/src/app/api/lab/instruments/route.test.ts apps/web/src/app/api/lab/instruments/[id]/bridge/route.test.ts apps/web/src/lib/lab-bridge-auth.test.ts",
    "test:memory-sync-outbox": "tsx --test packages/db/src/memory-sync-outbox-store.test.ts",
    "test:clinical-offline-writeup": "tsx --test packages/db/src/clinical-offline-writeup.test.ts",
    "test:clinical-offline-disposition": "tsx --test packages/db/src/clinical-offline-disposition.test.ts",
    "test:pharmacy-purchases": "tsx --test packages/db/src/pharmacy-purchases.test.ts",
    "test:clinical-offline-triage": "tsx --test packages/db/src/clinical-offline-triage.test.ts",
    "test:clinical-offline-prescribe": "tsx --test packages/db/src/clinical-offline-prescribe.test.ts",
    "test:rc1-pulse": "vitest run apps/web/src/lib/platform/rc1-pulse.test.ts",
    "test:hospital-sync-apply": "vitest run apps/web/src/app/api/hospital/sync/apply/route.test.ts",
    "test:sha-alignment": "vitest run apps/web/src/lib/platform/sha-alignment.test.ts",
    "journey:mfa-step-up-live": "node scripts/mfa-step-up-live-journey.mjs",
    "journey:referral-live": "node scripts/referral-live-journey.mjs",
    "journey:facility-onboarding-live": "tsx scripts/facility-onboarding-live.ts",
    "test:pharmacy-concurrency": "node --test scripts/db-tests/pharmacy-concurrency.local.test.mjs scripts/db-tests/auth-rate-limit.local.test.mjs scripts/db-tests/billing-expiry.local.test.mjs"
  },
