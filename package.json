    "test:vercel-config": "node --test scripts/vercel-crons.test.mjs",
    "test:offline-claims": "node --test scripts/offline-claims.test.mjs",
    "test:control-plane": "vitest run apps/web/src/lib/tenant-routing.test.ts packages/db/src/facility-provision.integration.test.ts packages/db/src/facility-invite-token.test.ts apps/web/src/lib/control-plane-security.test.ts apps/web/src/lib/platform/require-admin-api.test.ts apps/web/src/app/api/platform/facilities/[id]/staff/route.test.ts apps/web/src/app/api/platform/simulation/route.test.ts apps/web/src/lib/platform/facility-invitations.server.test.ts apps/web/src/lib/platform/facility-invitations.integration.test.ts apps/web/src/app/api/platform/mfa/step-up/route.test.ts apps/web/src/lib/platform/sha-alignment.test.ts apps/web/src/lib/platform/rc1-pulse.test.ts apps/web/src/app/api/hospital/sync/apply/route.test.ts apps/web/src/app/api/opd/prescriptions/route.test.ts apps/web/src/app/api/hospital/pharmacy/dispense/route.test.ts apps/web/src/app/api/opd/encounters/[id]/close/route.test.ts apps/web/src/app/api/opd/triage/route.test.ts",
