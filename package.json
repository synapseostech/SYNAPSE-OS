{
  "name": "synapse-os",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.7",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "apps/web",
    "apps/pharmacy",
    "apps/app",
    "apps/lab-edge",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
