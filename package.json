    "test:clinical-writeup": "tsx --test packages/db/src/clinical-writeup.test.ts",
    "test:hospital-closeout-golden": "tsx --test packages/db/src/hospital-closeout-golden.test.ts packages/db/src/encounter-close-gate.test.ts",
    "test:hospital-golden-journey": "tsx --test packages/db/src/hospital-golden-journey.test.ts",
    "test:routes": "node scripts/check-route-integrity.mjs",
    "test:db-acl": "node scripts/check-db-acl.mjs",
    "test:security-gates": "node scripts/check-security-gates.mjs",
    "test:rls-matrix": "tsx --test packages/db/src/rls-matrix.test.ts",
    "test:signed-record": "tsx --test packages/db/src/signed-record.test.ts packages/db/src/facility-lifecycle.test.ts packages/db/src/clinical-charge.test.ts packages/db/src/mpi-facility.test.ts packages/db/src/timeline.test.ts",
