    },
    "expo": "~52.0.46",
    "react-native": "0.76.9",
    "metro": "0.81.5",
    "metro-cache": "0.81.5",
    "metro-config": "0.81.5",
    "metro-transform-worker": "0.81.5",
    "@synapse/app": {
